# ── Logpose Web UI (System 2) ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# Directory of documents to make searchable (required)
LOGPOSE_CORPUS_DIR=~/Documents

# Additional corpus directories, comma-separated (optional)
# LOGPOSE_EXTRA_CORPUS_DIRS=~/Downloads/papers,~/notes

# Where this system stores its own ChromaDB (separate from logpose-mcp)
LOGPOSE_CHROMA_DIR=./chroma_db

# ChromaDB collection name
LOGPOSE_COLLECTION_NAME=logpose_ui

# Ollama instance
LOGPOSE_OLLAMA_BASE_URL=http://localhost:11434

# Embedding model (pull first: ollama pull nomic-embed-text-v2-moe)
LOGPOSE_EMBED_MODEL=nomic-embed-text-v2-moe

# Cross-encoder reranker
LOGPOSE_ENABLE_RERANKER=true
LOGPOSE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LOGPOSE_RERANK_TOP_K=30

# Chunking
LOGPOSE_CHUNK_SIZE=800
LOGPOSE_CHUNK_OVERLAP=150

# OCR for scanned PDFs (requires: brew install tesseract poppler)
LOGPOSE_ENABLE_OCR=true
LOGPOSE_OCR_MIN_CHARS_PER_PAGE=50

# Web server port
LOGPOSE_WEB_PORT=7892

# LLM for the Ask follow-up feature (pull first: ollama pull qwen3:0.6b)
LOGPOSE_CHAT_MODEL=qwen3:0.6b
OLLAMA_BASE_URL=http://localhost:11434
